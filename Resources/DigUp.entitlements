<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opening a recording at the moment that matched asks QuickTime Player to go there (macOS asks you once). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Share extension inbox (WeChat 合并转发 → DigUp Plus). Team-prefixed App Group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>3396ALL92C.group.com.yuezheng.digupplus.shared</string>
	</array>
</dict>
</plist>
